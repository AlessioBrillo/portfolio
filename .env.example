# Copy to .env.local (never committed) to opt into deploy-time behaviour.
# Everything is off by default — the build works without this file.

# --- Sitemap (postbuild) ---
# Canonical origin for dist/sitemap.xml (scripts/generate-sitemap.mjs).
# Keep unset until the real domain is configured: the interim vercel.app
# deployment then never advertises itself to crawlers.
VITE_SITE_URL=

# --- Analytics (Plausible, ADR-0013) ---
# The self-proxy rewrites are already provisioned in vercel.json
# (/js/script.js and /api/event -> plausible.io, inert until requested), so
# the strict CSP in vercel.json needs no change. Activation is two variables
# (plus an optional API base and SRI hash); dev, tests and pre-domain builds
# stay clean with the pair unset.
VITE_PLAUSIBLE_SRC=
VITE_PLAUSIBLE_DOMAIN=
# Optional API base for the event beacon (default: same-origin /api/event).
VITE_PLAUSIBLE_API=
# Optional SRI hash (sha384-...) of the analytics script.
VITE_PLAUSIBLE_INTEGRITY=