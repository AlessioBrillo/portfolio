# The Ascent — Deploy-time Environment Variables
#
# Copy to .env.local for local development (never commit .env.local)
# Set in Vercel Project Settings → Environment Variables for production/preview deployments.
#
# All variables are prefixed with VITE_ to be exposed to the client bundle.
# Variables without VITE_ prefix (e.g., in middleware.ts) are server-only.

# ─────────────────────────────────────────────────────────────────────────────
# SITE IDENTITY (required for canonical links, sitemap, OG metadata)
# ─────────────────────────────────────────────────────────────────────────────
# The production domain (e.g., https://alessiobrillo.com).
# Leave UNSET for preview deployments — no canonical links or sitemap emitted.
VITE_SITE_URL=

# ─────────────────────────────────────────────────────────────────────────────
# PLAUSIBLE ANALYTICS (ADR-0013, ADR-0020)
# ─────────────────────────────────────────────────────────────────────────────
# Plausible script source URL (e.g., https://plausible.io/js/script.js).
# Used by Edge Middleware (middleware.ts) to rewrite /js/script.js.
# Leave UNSET to disable analytics entirely (dev, tests, pre-domain).
VITE_PLAUSIBLE_SRC=

# The domain registered in Plausible (e.g., alessiobrillo.com).
# Used by Edge Middleware to activate rewrites AND by client to set data-domain.
# Leave UNSET to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=

# Optional: SRI hash for the Plausible script (sha384-...).
# Generate with: openssl dgst -sha384 -binary <script.js> | base64
# Recommended for production (ADR-0013).
VITE_PLAUSIBLE_INTEGRITY=

# ─────────────────────────────────────────────────────────────────────────────
# NODE / BUILD (managed by Vercel / .nvmrc)
# ─────────────────────────────────────────────────────────────────────────────
# Node version is pinned in .nvmrc and package.json engines.
# Vercel reads .nvmrc automatically. No env var needed.