# Copy to .env.local (never committed) to opt into deploy-time behaviour.
# Everything is off by default — the build works without this file.

# --- Sitemap (postbuild) ---
# Canonical origin for dist/sitemap.xml (scripts/generate-sitemap.mjs).
# Keep unset until the real domain is configured: the interim vercel.app
# deployment then never advertises itself to crawlers.
VITE_SITE_URL=

# --- Analytics (Plausible, ADR-0013) ---
# Both vars must be set for the beacon to load; dev, tests and pre-domain
# builds stay clean with the pair unset. Self-proxy through the site's own
# origin so the strict CSP in vercel.json needs no change:
#   vercel.json rewrite  /js/script.js  ->  https://plausible.io/js/script.js
#   vercel.json rewrite  /api/event     ->  https://plausible.io/api/event
VITE_PLAUSIBLE_SRC=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_API=
# Optional SRI hash (sha384-...) of the analytics script.
VITE_PLAUSIBLE_INTEGRITY=
